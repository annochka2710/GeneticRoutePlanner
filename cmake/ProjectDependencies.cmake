include_guard(GLOBAL)
option(GA_USE_LIBRARY_STUBS "Use placeholders for the private libraries" ON)
set(GA_PRIVATE_INCLUDE_DIRS "" CACHE STRING "Original SDK include directories")
set(GA_PRIVATE_LIBRARIES "" CACHE STRING "Original SDK library paths or CMake targets")
# The thesis uses Qt 5 APIs (QTextCodec and QSettings::setIniCodec).
find_package(Qt5 5.12 REQUIRED COMPONENTS Widgets)
add_library(ga_project_dependencies INTERFACE)
add_library(GeneticAlgorithm::Dependencies ALIAS ga_project_dependencies)
target_link_libraries(ga_project_dependencies INTERFACE Qt5::Widgets)
target_compile_features(ga_project_dependencies INTERFACE cxx_std_11)
if(GA_USE_LIBRARY_STUBS)
    get_filename_component(_ga_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
    target_include_directories(ga_project_dependencies INTERFACE "${_ga_root}/stubs/include")
    target_compile_definitions(ga_project_dependencies INTERFACE GA_LIBRARY_STUBS=1)
    message(STATUS "Private library stubs enabled: domain operations throw std::logic_error")
else()
    if(NOT GA_PRIVATE_INCLUDE_DIRS)
        message(FATAL_ERROR "Set GA_PRIVATE_INCLUDE_DIRS to the original SDK include directories")
    endif()
    target_include_directories(ga_project_dependencies INTERFACE ${GA_PRIVATE_INCLUDE_DIRS})
    target_link_libraries(ga_project_dependencies INTERFACE ${GA_PRIVATE_LIBRARIES})
endif()
